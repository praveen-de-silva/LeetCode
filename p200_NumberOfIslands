from collections import deque

class Solution(object):
    def BFS_visit(self, graph, start_pos):
        if graph[start_pos[0]][start_pos[1]] != "1":
            return False

        rows = len(graph)
        cols = len(graph[0])
        stack = deque([start_pos])

        while stack:
            crnt_pos = stack.popleft()
            graph[crnt_pos[0]][crnt_pos[1]] = "x"

            for (dx,dy) in [(0,1), (1,0), (0,-1), (-1,0)]:
                adj_pos = (crnt_pos[0]+dx, crnt_pos[1]+dy)

                if 0 <= adj_pos[0] < rows and 0 <= adj_pos[1] < cols and graph[adj_pos[0]][adj_pos[1]] == "1":
                    stack.append(adj_pos)
        return True

    def numIslands(self, grid):
        """
        :type grid: List[List[str]]
        :rtype: int
        """
        count = 0
    
        for i in range(len(grid)):
            for j in range(len(grid[0])):
                if grid[i][j] == "1":
                    self.BFS_visit(grid, (i, j))
                    count += 1
        return count
